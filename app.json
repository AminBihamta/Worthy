{
  "expo": {
    "name": "Worthy",
    "slug": "worthy",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "worthy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F5F2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aminbihamta.worthy",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#F6F5F2"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aminbihamta.worthy",
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-sqlite",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.aminbihamta.worthy.widgets",
          "groupIdentifier": "group.com.aminbihamta.worthy",
          "enableAndroid": true,
          "widgets": [
            {
              "name": "BalanceWidget",
              "displayName": "Total Balance",
              "description": "Your total balance across all accounts",
              "ios": {
                "supportedFamilies": ["systemSmall"]
              },
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "none"
              }
            },
            {
              "name": "MonthExpensesWidget",
              "displayName": "Monthly Expenses",
              "description": "Total expenses for the current calendar month",
              "ios": {
                "supportedFamilies": ["systemSmall"]
              },
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "none"
              }
            },
            {
              "name": "MonthIncomeWidget",
              "displayName": "Monthly Income",
              "description": "Total income for the current calendar month",
              "ios": {
                "supportedFamilies": ["systemSmall"]
              },
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "none"
              }
            },
            {
              "name": "QuickAddExpenseWidget",
              "displayName": "Quick Add Expense",
              "description": "Open Worthy to add an expense quickly",
              "ios": {
                "supportedFamilies": ["systemSmall"]
              },
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "none"
              }
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "71f86a3d-fc2b-4c88-af39-723842d49868"
      }
    },
    "owner": "amin81s-organization",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/71f86a3d-fc2b-4c88-af39-723842d49868"
    }
  }
}
